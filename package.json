{
  "name": "bikram-sambat-table",
  "version": "1.0.0",
  "description": "Bikram Sambat (Nepali BS) to Gregorian (AD) date conversion from a cross-checked month-length table, BS 2000 to 2090. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "LICENSE*", "NOTICE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/",
    "prepublishOnly": "npm test"
  },
  "keywords": ["bikram-sambat", "nepali-date", "nepali-calendar", "bs-to-ad", "ad-to-bs", "nepal", "date-converter", "patro"],
  "author": "Osama Mumtaz",
  "license": "MIT",
  "homepage": "https://github.com/osamamumtaz01/bikram-sambat-table#readme",
  "repository": { "type": "git", "url": "git+https://github.com/osamamumtaz01/bikram-sambat-table.git" },
  "bugs": { "url": "https://github.com/osamamumtaz01/bikram-sambat-table/issues" },
  "engines": { "node": ">=20" },
  "devDependencies": { "typescript": "^5.6.0" }
}
